---
// Inline SVG from src/assets/diagrams/, so the drawing takes the Starlight colors of the active theme
// (light or dark) through CSS variables; an <img> could not. See src/assets/diagrams/*.svg.
interface Props {
  name: string;
  caption?: string;
}
const { name, caption } = Astro.props;
const files = import.meta.glob('../assets/diagrams/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const svg = files[`../assets/diagrams/${name}.svg`];
if (!svg) throw new Error(`Diagram "${name}" not found in src/assets/diagrams/`);
---

<figure class="diagram">
  <div class="scroll"><Fragment set:html={svg} /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .diagram {
    margin: 1.5rem 0;
  }
  .scroll {
    overflow-x: auto;
  }
  .diagram :global(svg) {
    display: block;
    width: 100%;
    min-width: 560px;
    height: auto;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
</style>
